{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "auto-config",
    "version": "1.0.0",
    "author": "honmono",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc",
        "watch": "tsc -w"
    },
    "description": "i18n:auto-config.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/node": "^18.19.118",
        "typescript": "^5.8.2"
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:menu.extension/i18n:auto-config",
                "label": "i18n:auto-config.generate",
                "message": "generate"
            }
        ],
        "messages": {
            "show-log": {
                "methods": [
                    "showLog"
                ]
            },
            "generate": {
                "methods": [
                    "generate"
                ]
            }
        },
        "scene": {
            "script": "./dist/scene.js"
        },
        "shortcuts": [
            {
                "message": "generate",
                "win": "Alt+F",
                "mac": "Alt+F"
            }
        ]
    }
}